{
    "rules": {
        "classes": {
            ".read": true,
            ".write": "auth != null"
        },
        "class_notices": {
            ".read": true,
            "$classId": {
                ".write": "auth != null"
            }
        },
        "notices": {
            ".read": true,
            ".write": "auth != null"
        },
        "faqs": {
            ".read": true,
            ".write": "auth != null"
        },
        "notice_likes": {
            ".read": true,
            ".write": "auth != null"
        },
        "notice_comments": {
            ".read": true,
            ".write": "auth != null"
        },
        "reviews": {
            ".read": true,
            "$classId": {
                ".write": "auth != null"
            }
        },
        "chats": {
            ".read": true,
            "$chatId": {
                ".write": "auth != null"
            }
        },
        "group_chats": {
            ".read": true,
            "$groupId": {
                ".write": "auth != null"
            }
        },
        "dm": {
            ".read": "auth != null",
            "$roomId": {
                ".write": "auth != null"
            }
        },
        "user_chats": {
            "$userId": {
                ".read": "auth != null",
                ".write": "auth != null"
            }
        },
        "enrollments": {
            ".read": true,
            "$userId": {
                ".write": "auth != null"
            }
        },
        "contacts": {
            "$userId": {
                ".read": "auth != null",
                ".write": "auth != null"
            }
        },
        "presence": {
            ".read": true,
            "$userId": {
                ".write": "auth != null"
            }
        },
        "payment_methods": {
            "$userId": {
                ".read": "auth != null && $userId === auth.uid",
                ".write": "auth != null && $userId === auth.uid"
            }
        },
        "user_settings": {
            "$userId": {
                ".read": "auth != null && $userId === auth.uid",
                ".write": "auth != null && $userId === auth.uid"
            }
        },
        "inquiries": {
            ".read": "auth != null",
            ".write": "auth != null"
        }
    }
}