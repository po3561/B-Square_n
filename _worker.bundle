    item.payment_count += grossAmount > 0 ? 1 : 0;
    item.refund_count += refundAmount > 0 ? 1 : 0;
    item.gross_revenue += grossAmount;
    item.refund_amount += refundAmount;
    item.net_revenue += netRevenue;
    item.orders.push({
      order_id: row.order_id,
