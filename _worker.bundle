        id: batch.id,
        batch_id: batch.id,
        year: batch.year,
        month: batch.month,
        instructor_id: item.instructor_id || null,
        instructor_name: item.instructor_name || "-",
        instructor_email: item.instructor_email || "",
        instructor_phone: item.instructor_phone || "",
