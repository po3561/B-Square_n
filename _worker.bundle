    day: `date(paid_at) = date('now')`,
    week: `datetime(paid_at) >= datetime('now', '-6 days')`,
    month: `datetime(paid_at) >= datetime('now', 'start of month')`,
    year: `datetime(paid_at) >= datetime('now', 'start of year')`
  };
