      reference_id = COALESCE(NULLIF(TRIM(reference_id), ''), NULLIF(TRIM(class_id), ''), id)
    WHERE
      item_type IS NULL
      OR TRIM(item_type) = ''
      OR reference_id IS NULL
      OR TRIM(reference_id) = ''
  `).run();
}
