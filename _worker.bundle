      COUNT(*) AS class_count,
      COALESCE(SUM(cs.total_visits), 0) AS total_visits,
      COALESCE(SUM(cs.total_enrollments), SUM(c.current_participants), 0) AS total_enrollments,
      COALESCE(SUM(cs.total_revenue), 0) AS total_revenue,
