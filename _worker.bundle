        return new Response(JSON.stringify({ success: false, error: "\uBAA8\uC9D1 \uC778\uC6D0\uC774 \uB9C8\uAC10\uB418\uC5C8\uC2B5\uB2C8\uB2E4." }), { status: 400, headers: cors });
